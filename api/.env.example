# API configuration
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database — SQLite by default; swap for a Postgres DSN in production
DATABASE_URL=sqlite:///./didcot.db

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=1440

# Seed admin (only created if no admin exists)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin

# Outbound webhook for new bookings (optional)
BOOKING_NOTIFY_WEBHOOK=

# Server-side tracking forwarders (optional)
GA_API_SECRET=
GA_MEASUREMENT_ID=
META_CAPI_TOKEN=
META_PIXEL_ID=
