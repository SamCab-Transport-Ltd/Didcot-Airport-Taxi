# Public site URL (used for canonical, OG, sitemap)
NEXT_PUBLIC_SITE_URL=https://didcotairporttaxi.co.uk

# Business contact (also surfaces in schema + UI)
NEXT_PUBLIC_BUSINESS_PHONE=+441235000000
NEXT_PUBLIC_BUSINESS_WHATSAPP=+441235000000
NEXT_PUBLIC_BUSINESS_EMAIL=bookings@didcotairporttaxi.co.uk

# Tracking — client
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Tracking — server-side (kept secret)
GA_API_SECRET=
GA_MEASUREMENT_ID=
META_CAPI_TOKEN=
META_PIXEL_ID=
TIKTOK_CAPI_TOKEN=
TIKTOK_PIXEL_ID=

# Booking webhook (where bookings are forwarded as a fallback)
BOOKING_WEBHOOK_URL=
BOOKING_NOTIFY_EMAIL=

# FastAPI backend (admin dashboard + booking persistence)
# Server-only (used by Next.js API routes); use NEXT_PUBLIC_API_URL only if you
# also need to call the backend directly from client components.
BACKEND_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
